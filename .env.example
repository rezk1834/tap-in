# Supabase (public values only). If you use the Vercel + Supabase integration, the NEXT_PUBLIC_* versions are already set there.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only used when Supabase is NOT configured (local fallback dashboard password)
VITE_ADMIN_PASSWORD=change-me
